{
	"name": "ws-wp-profile-display-block",
	"version": "0.1.0",
	"description": "WordPress.org のプロフィールをカードとして表示するブロック",
	"private": true,
	"license": "GPL-2.0-or-later",
	"files": [
		"assets",
		"build",
		"includes",
		"README.md",
		"README.ja.md",
		"uninstall.php",
		"ws-wp-profile-display-block.php"
	],
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js src",
		"lint:css": "wp-scripts lint-style src/**/*.scss",
		"wp-env": "wp-env",
		"pretest:e2e": "wp-env run tests-cli wp theme activate twentytwentyfive && wp-env run tests-cli wp plugin activate ws-wp-profile-display-block",
		"test:e2e": "playwright test",
		"pretest:e2e:ui": "npm run pretest:e2e",
		"test:e2e:ui": "playwright test --ui",
		"prepare": "husky"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@wordpress/e2e-test-utils-playwright": "^1.52.0",
		"@wordpress/env": "^11.12.0",
		"@wordpress/scripts": "^34.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0"
	},
	"dependencies": {
		"@wordpress/server-side-render": "^6.28.0"
	},
	"lint-staged": {
		"*.php": "composer run phpcs --"
	}
}
